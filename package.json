{
  "name": "mcp-forge",
  "version": "1.0.0",
  "description": "The Swiss-Army knife developer toolkit for building, inspecting, and serving Model Context Protocol (MCP) servers.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-forge": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node ./dist/cli.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "devtools",
    "inspector",
    "cli",
    "llm",
    "anthropic"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sweecksss/mcp-forge.git"
  },
  "bugs": {
    "url": "https://github.com/sweecksss/mcp-forge/issues"
  },
  "homepage": "https://github.com/sweecksss/mcp-forge#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.1.0",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "express": "^4.21.2",
    "inquirer": "^9.3.7",
    "open": "^10.1.0",
    "ora": "^5.4.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.14.9",
    "@types/ws": "^8.5.10",
    "tsup": "^8.1.0",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
